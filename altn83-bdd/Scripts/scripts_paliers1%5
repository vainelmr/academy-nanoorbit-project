/* PALIER 5 - EXERCICE 13 */

SET SERVEROUTPUT ON;

CREATE OR REPLACE PROCEDURE valider_fenetre_avant_insertion (
p_id_satellite IN SATELLITE.id_satellite%TYPE,
p_code_station IN STATION_SOL.code_station%TYPE,
p_datetime_debut IN FENETRE_COM.datetime_debut%TYPE,
p_duree IN FENETRE_COM.duree%TYPE
)
IS
v_statut_satellite SATELLITE.statut%TYPE;
v_statut_station STATION_SOL.statut%TYPE;
v_nb_chev_sat NUMBER := 0;
v_nb_chev_station NUMBER := 0;
v_fin_fenetre TIMESTAMP;
BEGIN

SELECT statut
INTO v_statut_satellite
FROM SATELLITE
WHERE id_satellite = p_id_satellite;

IF v_statut_satellite <> 'Opérationnel' THEN
RAISE_APPLICATION_ERROR(
-20101,
'Validation refusée : le satellite ' || p_id_satellite ||
' n''est pas opérationnel.'
);
END IF;

SELECT statut
INTO v_statut_station
FROM STATION_SOL
WHERE code_station = p_code_station;

IF v_statut_station <> 'Active' THEN
RAISE_APPLICATION_ERROR(
-20102,
'Validation refusée : la station ' || p_code_station ||
' n''est pas active.'
);
END IF;

IF p_duree < 1 OR p_duree > 900 THEN
RAISE_APPLICATION_ERROR(
-20103,
'Validation refusée : la durée doit être comprise entre 1 et 900 secondes.'
);
END IF;

v_fin_fenetre := p_datetime_debut + NUMTODSINTERVAL(p_duree, 'SECOND');

SELECT COUNT(*)
INTO v_nb_chev_sat
FROM FENETRE_COM f
WHERE f.id_satellite = p_id_satellite
AND f.datetime_debut < v_fin_fenetre
AND (f.datetime_debut + NUMTODSINTERVAL(f.duree, 'SECOND')) > p_datetime_debut;

IF v_nb_chev_sat > 0 THEN
RAISE_APPLICATION_ERROR(
-20104,
'Validation refusée : chevauchement détecté pour le satellite ' || p_id_satellite || '.'
);
END IF;

SELECT COUNT(*)
INTO v_nb_chev_station
FROM FENETRE_COM f
WHERE f.code_station = p_code_station
AND f.datetime_debut < v_fin_fenetre
AND (f.datetime_debut + NUMTODSINTERVAL(f.duree, 'SECOND')) > p_datetime_debut;

IF v_nb_chev_station > 0 THEN
RAISE_APPLICATION_ERROR(
-20105,
'Validation refusée : chevauchement détecté pour la station ' || p_code_station || '.'
);
END IF;

DBMS_OUTPUT.PUT_LINE('Validation réussie : la fenêtre peut être insérée.');

EXCEPTION
WHEN NO_DATA_FOUND THEN
RAISE_APPLICATION_ERROR(
-20106,
'Validation refusée : satellite ou station introuvable.'
);
END;
/
SHOW ERRORS PROCEDURE valider_fenetre_avant_insertion;

/* Tests */

BEGIN
