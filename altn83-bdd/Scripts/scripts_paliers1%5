/* PALIER 3 - EXERCICE 5 */

SET SERVEROUTPUT ON;

DECLARE
v_id_satellite SATELLITE.id_satellite%TYPE := 'SAT-001';
/*v_id_satellite SATELLITE.id_satellite%TYPE := 'SAT-004';*/
/*v_id_satellite SATELLITE.id_satellite%TYPE := 'SAT-005';*/
v_nom_satellite SATELLITE.nom_satellite%TYPE;
v_statut SATELLITE.statut%TYPE;
v_date_lancement SATELLITE.date_lancement%TYPE;
v_duree_vie_prevue SATELLITE.duree_vie_prevue%TYPE;
v_duree_restante NUMBER;
v_categorie VARCHAR2(100);
BEGIN
SELECT nom_satellite,
statut,
date_lancement,
duree_vie_prevue
INTO v_nom_satellite,
v_statut,
v_date_lancement,
v_duree_vie_prevue
FROM SATELLITE
WHERE id_satellite = v_id_satellite;

v_duree_restante := v_duree_vie_prevue - FLOOR(MONTHS_BETWEEN(SYSDATE, v_date_lancement));

IF v_statut = 'Désorbité' THEN
v_categorie := 'Satellite hors service définitif';
ELSIF v_statut = 'Défaillant' THEN
v_categorie := 'Satellite en anomalie critique';
ELSIF v_statut = 'En veille' THEN
v_categorie := 'Satellite temporairement inactif';
ELSIF v_statut = 'Opérationnel' AND v_duree_restante > 24 THEN
v_categorie := 'Satellite opérationnel avec bonne marge de vie';
ELSIF v_statut = 'Opérationnel' AND v_duree_restante BETWEEN 1 AND 24 THEN
v_categorie := 'Satellite opérationnel en fin de vie';
ELSE
v_categorie := 'Satellite en fin de mission ou durée dépassée';
END IF;

DBMS_OUTPUT.PUT_LINE('Analyse du satellite ' || v_id_satellite);
DBMS_OUTPUT.PUT_LINE('Nom : ' || v_nom_satellite);
DBMS_OUTPUT.PUT_LINE('Statut : ' || v_statut);
DBMS_OUTPUT.PUT_LINE('Durée de vie prévue : ' || v_duree_vie_prevue || ' mois');
DBMS_OUTPUT.PUT_LINE('Durée restante estimée : ' || v_duree_restante || ' mois');
DBMS_OUTPUT.PUT_LINE('Catégorie : ' || v_categorie);
END;
/

-- Test 1 : SAT-001
-- Attendu : statut Opérationnel, catégorie selon durée restante

-- Test 2 : SAT-004
-- Attendu : catégorie Satellite temporairement inactif

-- Test 3 : SAT-005
-- Attendu : catégorie Satellite hors service définitif

/* PALIER 3 - EXERCICE 6 */

SET SERVEROUTPUT ON;

DECLARE
v_id_satellite SATELLITE.id_satellite%TYPE := 'SAT-001';
/*v_id_satellite SATELLITE.id_satellite%TYPE := 'SAT-003';*/
/*v_id_satellite SATELLITE.id_satellite%TYPE := 'SAT-005';*/
v_nom_satellite SATELLITE.nom_satellite%TYPE;
v_type_orbite ORBITE.type_orbite%TYPE;
v_altitude ORBITE.altitude%TYPE;
v_periode ORBITE.periode_orbitale%TYPE;
v_description VARCHAR2(100);
v_vitesse NUMBER(10,2);
BEGIN
SELECT s.nom_satellite,
o.type_orbite,
o.altitude,
o.periode_orbitale
INTO v_nom_satellite,
v_type_orbite,
v_altitude,
v_periode
FROM SATELLITE s
JOIN ORBITE o ON s.id_orbite = o.id_orbite
WHERE s.id_satellite = v_id_satellite;

v_description :=
CASE v_type_orbite
WHEN 'LEO' THEN 'Orbite basse terrestre'
WHEN 'MEO' THEN 'Orbite terrestre moyenne'
WHEN 'SSO' THEN 'Orbite héliosynchrone'
WHEN 'GEO' THEN 'Orbite géostationnaire'
ELSE 'Type d''orbite inconnu'
END;

v_vitesse := (2 * ACOS(-1) * (6371 + v_altitude)) / v_periode;

DBMS_OUTPUT.PUT_LINE('Analyse orbitale du satellite ' || v_id_satellite);
DBMS_OUTPUT.PUT_LINE('Nom : ' || v_nom_satellite);
DBMS_OUTPUT.PUT_LINE('Type d''orbite : ' || v_type_orbite);
DBMS_OUTPUT.PUT_LINE('Description : ' || v_description);
DBMS_OUTPUT.PUT_LINE('Altitude : ' || v_altitude || ' km');
DBMS_OUTPUT.PUT_LINE('Période orbitale : ' || v_periode || ' min');
DBMS_OUTPUT.PUT_LINE('Vitesse orbitale approximative : ' || ROUND(v_vitesse, 2) || ' km/min');
END;
/

-- Test 1 : SAT-001
-- Attendu : SSO, Orbite héliosynchrone

-- Test 2 : SAT-003
-- Attendu : SSO, Orbite héliosynchrone

-- Test 3 : SAT-005
-- Attendu : LEO, Orbite basse terrestre

/* PALIER 3 - EXERCICE 7 */

SET SERVEROUTPUT ON;

DECLARE
v_code_station STATION_SOL.code_station%TYPE := 'GS-TLS-01';
v_nom_station STATION_SOL.nom_station%TYPE;
v_debit_max STATION_SOL.debit_max%TYPE;
v_volume_theo NUMBER(10,2);
BEGIN
SELECT nom_station, debit_max
INTO v_nom_station, v_debit_max
FROM STATION_SOL
WHERE code_station = v_code_station;

DBMS_OUTPUT.PUT_LINE('Grille des volumes théoriques - ' || v_code_station);
DBMS_OUTPUT.PUT_LINE('Station : ' || v_nom_station);
DBMS_OUTPUT.PUT_LINE('Débit max : ' || v_debit_max || ' Mbps');
DBMS_OUTPUT.PUT_LINE('---------------------------------------------');

FOR v_duree_min IN 5 .. 15 LOOP
v_volume_theo := (v_debit_max * (v_duree_min * 60)) / 8;

DBMS_OUTPUT.PUT_LINE(
'Durée : ' || v_duree_min || ' min'
|| ' -> Volume théorique : '
|| ROUND(v_volume_theo, 2) || ' Mo'
);
END LOOP;
END;
/

-- Attendu : Toulouse Ground Station, 150 Mbps, volumes théoriques de 5 à 15 min

