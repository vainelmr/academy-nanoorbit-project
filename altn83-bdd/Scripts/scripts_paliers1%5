/* PALIER 2 - EXERCICE 4 */

SET SERVEROUTPUT ON;

DECLARE
v_ref_instrument INSTRUMENT.ref_instrument%TYPE := 'INS-AIS-01';
/*v_ref_instrument INSTRUMENT.ref_instrument%TYPE := 'INS-CAM-01';*/
v_modele INSTRUMENT.modele%TYPE;
v_type INSTRUMENT.type_instrument%TYPE;
v_resolution VARCHAR2(20);
BEGIN
SELECT modele,
type_instrument,
NVL(TO_CHAR(resolution), 'N/A')
INTO v_modele,
v_type,
v_resolution
FROM INSTRUMENT
WHERE ref_instrument = v_ref_instrument;

DBMS_OUTPUT.PUT_LINE('Informations de l''instrument ' || v_ref_instrument);
DBMS_OUTPUT.PUT_LINE('Modèle : ' || v_modele);
DBMS_OUTPUT.PUT_LINE('Type : ' || v_type);
DBMS_OUTPUT.PUT_LINE('Résolution : ' || v_resolution);
END;
/

