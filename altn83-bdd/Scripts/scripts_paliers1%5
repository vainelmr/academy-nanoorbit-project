/* PALIER 5 - EXERCICE 14 */

SET SERVEROUTPUT ON;

CREATE OR REPLACE PROCEDURE afficher_statut_satellite (
    p_id IN SATELLITE.id_satellite%TYPE
)
IS
    v_nom_satellite   SATELLITE.nom_satellite%TYPE;
    v_statut          SATELLITE.statut%TYPE;
    v_type_orbite     ORBITE.type_orbite%TYPE;
    v_altitude        ORBITE.altitude%TYPE;
    v_nb_instr        NUMBER := 0;
BEGIN
    
    SELECT s.nom_satellite,
           s.statut,
           o.type_orbite,
           o.altitude
    INTO   v_nom_satellite,
           v_statut,
           v_type_orbite,
           v_altitude
    FROM SATELLITE s
    JOIN ORBITE o
      ON s.id_orbite = o.id_orbite
    WHERE s.id_satellite = p_id;

    DBMS_OUTPUT.PUT_LINE('Satellite : ' || p_id || ' - ' || v_nom_satellite);
    DBMS_OUTPUT.PUT_LINE('Statut : ' || v_statut);
    DBMS_OUTPUT.PUT_LINE('Orbite : ' || v_type_orbite || ' (' || v_altitude || ' km)');
    DBMS_OUTPUT.PUT_LINE('Instruments embarqués :');

    FOR rec IN (
        SELECT i.ref_instrument,
               i.type_instrument,
               i.modele,
               e.etat_fonctionnement
        FROM EMBARQUEMENT e
        JOIN INSTRUMENT i
          ON e.ref_instrument = i.ref_instrument
        WHERE e.id_satellite = p_id
        ORDER BY i.ref_instrument
    ) LOOP
        v_nb_instr := v_nb_instr + 1;

        DBMS_OUTPUT.PUT_LINE(
            ' - ' || rec.ref_instrument
            || ' | ' || rec.type_instrument
            || ' | ' || rec.modele
            || ' | Etat : ' || rec.etat_fonctionnement
        );
    END LOOP;

    IF v_nb_instr = 0 THEN
        DBMS_OUTPUT.PUT_LINE(' - Aucun instrument embarqué');
    END IF;

EXCEPTION
    WHEN NO_DATA_FOUND THEN
        DBMS_OUTPUT.PUT_LINE(
            'Aucun satellite trouvé pour l''identifiant ' || p_id
        );
    WHEN OTHERS THEN
        DBMS_OUTPUT.PUT_LINE(
            'Erreur lors de l''affichage du satellite ' || p_id || ' : ' || SQLERRM
        );
END;
/
SHOW ERRORS PROCEDURE afficher_statut_satellite;

/* Tests */

BEGIN
afficher_statut_satellite('SAT-001');
END;
/

BEGIN
    afficher_statut_satellite('SAT-004');
END;
/

BEGIN
    afficher_statut_satellite('SAT-999');
END;
/

/* PALIER 5 - EXERCICE 15 */

SET SERVEROUTPUT ON;

CREATE OR REPLACE PROCEDURE mettre_a_jour_statut (
    p_id             IN  SATELLITE.id_satellite%TYPE,
    p_statut         IN  SATELLITE.statut%TYPE,
    p_ancien_statut  OUT SATELLITE.statut%TYPE
)
IS
BEGIN
    
    SELECT statut
    INTO p_ancien_statut
    FROM SATELLITE
    WHERE id_satellite = p_id;

    IF p_statut NOT IN ('Opérationnel', 'En veille', 'Défaillant', 'Désorbité') THEN
        RAISE_APPLICATION_ERROR(
            -20201,
            'Statut invalide : ' || p_statut
        );
    END IF;

    UPDATE SATELLITE
    SET statut = p_statut
    WHERE id_satellite = p_id;

    DBMS_OUTPUT.PUT_LINE(
        'Satellite ' || p_id || ' mis à jour : '
        || p_ancien_statut || ' -> ' || p_statut
    );

EXCEPTION
    WHEN NO_DATA_FOUND THEN
        DBMS_OUTPUT.PUT_LINE(
            'Aucun satellite trouvé pour l''identifiant ' || p_id
        );
    WHEN OTHERS THEN
        DBMS_OUTPUT.PUT_LINE(
            'Erreur lors de la mise à jour du satellite '
            || p_id || ' : ' || SQLERRM
        );
END;
/
SHOW ERRORS PROCEDURE mettre_a_jour_statut;

/* Tests */

DECLARE
    v_ancien_statut SATELLITE.statut%TYPE;
BEGIN
    mettre_a_jour_statut('SAT-004', 'Défaillant', v_ancien_statut);
    DBMS_OUTPUT.PUT_LINE('Ancien statut retourné : ' || v_ancien_statut);
    ROLLBACK;
END;
/

