/* PALIER 1 - EXERCICE 1 */

SET SERVEROUTPUT ON;

DECLARE
    v_nb_satellites NUMBER;
    v_nb_stations   NUMBER;
    v_nb_missions   NUMBER;
BEGIN
    SELECT COUNT(*) INTO v_nb_satellites FROM SATELLITE;
    SELECT COUNT(*) INTO v_nb_stations   FROM STATION_SOL;
    SELECT COUNT(*) INTO v_nb_missions   FROM MISSION;

    DBMS_OUTPUT.PUT_LINE('Bienvenue dans le système NanoOrbit');
    DBMS_OUTPUT.PUT_LINE('Nombre de satellites : ' || v_nb_satellites);
    DBMS_OUTPUT.PUT_LINE('Nombre de stations   : ' || v_nb_stations);
    DBMS_OUTPUT.PUT_LINE('Nombre de missions   : ' || v_nb_missions);
END;
/

-- Attendu : 5 satellites, 3 stations, 3 missions

/* PALIER 1 - EXERCICE 2 */

SET SERVEROUTPUT ON;

DECLARE
    v_nom_satellite      SATELLITE.nom_satellite%TYPE;
    v_date_lancement     SATELLITE.date_lancement%TYPE;
    v_masse              SATELLITE.masse%TYPE;
    v_format_cubesat     SATELLITE.format_cubesat%TYPE;
    v_statut             SATELLITE.statut%TYPE;
    v_duree_vie_prevue   SATELLITE.duree_vie_prevue%TYPE;
    v_capacite_batterie  SATELLITE.capacite_batterie%TYPE;
BEGIN
    SELECT nom_satellite,
           date_lancement,
           masse,
           format_cubesat,
           statut,
           duree_vie_prevue,
           capacite_batterie
    INTO   v_nom_satellite,
           v_date_lancement,
           v_masse,
           v_format_cubesat,
           v_statut,
           v_duree_vie_prevue,
           v_capacite_batterie
    FROM SATELLITE
    WHERE id_satellite = 'SAT-001';

    DBMS_OUTPUT.PUT_LINE('Caractéristiques du satellite SAT-001');
    DBMS_OUTPUT.PUT_LINE('Nom : ' || v_nom_satellite);
    DBMS_OUTPUT.PUT_LINE('Date de lancement : ' || TO_CHAR(v_date_lancement, 'DD/MM/YYYY'));
    DBMS_OUTPUT.PUT_LINE('Masse : ' || v_masse || ' kg');
    DBMS_OUTPUT.PUT_LINE('Format CubeSat : ' || v_format_cubesat);
    DBMS_OUTPUT.PUT_LINE('Statut : ' || v_statut);
    DBMS_OUTPUT.PUT_LINE('Durée de vie prévue : ' || v_duree_vie_prevue || ' mois');
    DBMS_OUTPUT.PUT_LINE('Capacité batterie : ' || v_capacite_batterie || ' Wh');
END;
/

-- Attendu : NanoOrbit-Alpha, 15/03/2022, 1.3 kg, 3U, Opérationnel, 60 mois, 20 Wh

