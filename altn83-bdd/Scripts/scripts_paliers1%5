/* PALIER 5 - EXERCICE 16 */

SET SERVEROUTPUT ON;

CREATE OR REPLACE FUNCTION calculer_volume_session (
    p_id_fenetre IN FENETRE_COM.id_fenetre%TYPE
)
RETURN NUMBER
IS
    v_duree       FENETRE_COM.duree%TYPE;
    v_debit_max   STATION_SOL.debit_max%TYPE;
    v_volume      NUMBER(12,2);
BEGIN
    SELECT f.duree,
           s.debit_max
    INTO   v_duree,
           v_debit_max
    FROM FENETRE_COM f
    JOIN STATION_SOL s
      ON f.code_station = s.code_station
    WHERE f.id_fenetre = p_id_fenetre;

    v_volume := (v_debit_max * v_duree) / 8;

    RETURN v_volume;

EXCEPTION
    WHEN NO_DATA_FOUND THEN
        RAISE_APPLICATION_ERROR(
            -20301,
            'Aucune fenêtre trouvée pour l''identifiant ' || p_id_fenetre
        );
    WHEN OTHERS THEN
        RAISE_APPLICATION_ERROR(
            -20302,
            'Erreur lors du calcul du volume de la fenêtre '
            || p_id_fenetre || ' : ' || SQLERRM
        );
END;
/
SHOW ERRORS FUNCTION calculer_volume_session;