/* PALIER 4 - EXERCICE 9 */

SET SERVEROUTPUT ON;

BEGIN
FOR rec IN (
SELECT
s.id_satellite,
s.nom_satellite,
s.statut,
o.type_orbite,
o.altitude,
i.ref_instrument,
i.type_instrument,
i.modele,
e.etat_fonctionnement
FROM SATELLITE s
JOIN ORBITE o
ON s.id_orbite = o.id_orbite
LEFT JOIN EMBARQUEMENT e
ON s.id_satellite = e.id_satellite
LEFT JOIN INSTRUMENT i
ON e.ref_instrument = i.ref_instrument
ORDER BY s.id_satellite, i.ref_instrument
) LOOP
DBMS_OUTPUT.PUT_LINE(
'Satellite : ' || rec.id_satellite || ' - ' || rec.nom_satellite
);
DBMS_OUTPUT.PUT_LINE(
' Statut : ' || rec.statut
|| ' | Orbite : ' || rec.type_orbite
|| ' (' || rec.altitude || ' km)'
);
DBMS_OUTPUT.PUT_LINE(
' Instrument : ' || rec.ref_instrument
|| ' | Type : ' || rec.type_instrument
|| ' | Modèle : ' || rec.modele
|| ' | État : ' || rec.etat_fonctionnement
);
DBMS_OUTPUT.PUT_LINE('--------------------------------------------------');
END LOOP;
END;
/

-- Attendu : affichage des 7 embarquements avec détails sur les satellites, orbites et instruments associés

/* PALIER 4 - EXERCICE 10 */

SET SERVEROUTPUT ON;

DECLARE
CURSOR c_satellites_operationnels IS
SELECT
s.id_satellite,
s.nom_satellite,
f.datetime_debut,
st.code_station,
st.nom_station
FROM SATELLITE s
JOIN FENETRE_COM f
ON s.id_satellite = f.id_satellite
JOIN STATION_SOL st
ON f.code_station = st.code_station
WHERE s.statut = 'Opérationnel'
AND f.datetime_debut = (
SELECT MAX(f2.datetime_debut)
FROM FENETRE_COM f2
WHERE f2.id_satellite = s.id_satellite
)
ORDER BY s.id_satellite;

v_id_satellite SATELLITE.id_satellite%TYPE;
v_nom_satellite SATELLITE.nom_satellite%TYPE;
v_datetime FENETRE_COM.datetime_debut%TYPE;
v_code_station STATION_SOL.code_station%TYPE;
v_nom_station STATION_SOL.nom_station%TYPE;
BEGIN
OPEN c_satellites_operationnels;

LOOP
FETCH c_satellites_operationnels
INTO v_id_satellite,
v_nom_satellite,
v_datetime,
v_code_station,
v_nom_station;

EXIT WHEN c_satellites_operationnels%NOTFOUND;

DBMS_OUTPUT.PUT_LINE('Satellite : ' || v_id_satellite || ' - ' || v_nom_satellite);
DBMS_OUTPUT.PUT_LINE('Dernière communication : ' || TO_CHAR(v_datetime, 'DD/MM/YYYY HH24:MI:SS'));
DBMS_OUTPUT.PUT_LINE('Station : ' || v_code_station || ' - ' || v_nom_station);
DBMS_OUTPUT.PUT_LINE('--------------------------------------------------');
END LOOP;

CLOSE c_satellites_operationnels;
END;
/

-- Attendu : SAT-001, SAT-002, SAT-003 avec leur station la plus récente

/* PALIER 4 - EXERCICE 11 */

SET SERVEROUTPUT ON;

DECLARE
v_code_station   STATION_SOL.code_station%TYPE := 'GS-TLS-01';
/*v_code_station   STATION_SOL.code_station%TYPE := 'GS-KIR-01';*/
/*v_code_station   STATION_SOL.code_station%TYPE := 'GS-SGP-01';*/
    v_nom_station    STATION_SOL.nom_station%TYPE;
    v_volume_total   NUMBER(10,1) := 0;

    CURSOR c_fenetres_station (p_code_station STATION_SOL.code_station%TYPE) IS
        SELECT
            f.id_fenetre,
            f.datetime_debut,
            f.duree,
            f.statut,
            NVL(f.volume_donnees, 0) AS volume_donnees,
            s.id_satellite,
            s.nom_satellite
        FROM FENETRE_COM f
        JOIN SATELLITE s
            ON f.id_satellite = s.id_satellite
        WHERE f.code_station = p_code_station
        ORDER BY f.datetime_debut;

BEGIN
    SELECT nom_station
    INTO v_nom_station
    FROM STATION_SOL
    WHERE code_station = v_code_station;

    DBMS_OUTPUT.PUT_LINE('Fenêtres de communication de la station ' || v_code_station);
    DBMS_OUTPUT.PUT_LINE('Nom station : ' || v_nom_station);
    DBMS_OUTPUT.PUT_LINE('--------------------------------------------------');

    FOR rec IN c_fenetres_station(v_code_station) LOOP
        DBMS_OUTPUT.PUT_LINE(
            'Fenêtre #' || rec.id_fenetre
            || ' | Début : ' || TO_CHAR(rec.datetime_debut, 'DD/MM/YYYY HH24:MI:SS')
            || ' | Durée : ' || rec.duree || ' s'
            || ' | Statut : ' || rec.statut
        );

        DBMS_OUTPUT.PUT_LINE(
            '  Satellite : ' || rec.id_satellite || ' - ' || rec.nom_satellite
        );

        DBMS_OUTPUT.PUT_LINE(
            '  Volume téléchargé : ' || rec.volume_donnees || ' Mo'
        );

        v_volume_total := v_volume_total + rec.volume_donnees;
    END LOOP;

    DBMS_OUTPUT.PUT_LINE('Volume total téléchargé pour la station '
                         || v_code_station || ' : ' || v_volume_total || ' Mo');
END;
/

-- Test 1 : GS-TLS-01
-- Attendu : 3 fenêtres, volume total 890 Mo

-- Test 2 : GS-KIR-01
-- Attendu : 2 fenêtres, volume total 2930 Mo

-- Test 3 : GS-SGP-01
-- Attendu : 0 fenêtre, volume total 0 Mo

/* PHASE 3 - PALIER 5 - EXERCICE 12 */

SET SERVEROUTPUT ON;

DECLARE
v_id_satellite SATELLITE.id_satellite%TYPE := 'SAT-001';
/*v_id_satellite SATELLITE.id_satellite%TYPE := 'SAT-999';*/
/*v_id_satellite SATELLITE.id_satellite%TYPE := 'SAT-005';*/
v_nom_satellite SATELLITE.nom_satellite%TYPE;
v_statut SATELLITE.statut%TYPE;
v_format_cubesat SATELLITE.format_cubesat%TYPE;
BEGIN
SELECT nom_satellite,
statut,
format_cubesat
INTO v_nom_satellite,
v_statut,
v_format_cubesat
FROM SATELLITE
WHERE id_satellite = v_id_satellite;

DBMS_OUTPUT.PUT_LINE('Satellite trouvé : ' || v_id_satellite);
DBMS_OUTPUT.PUT_LINE('Nom : ' || v_nom_satellite);
DBMS_OUTPUT.PUT_LINE('Statut : ' || v_statut);
DBMS_OUTPUT.PUT_LINE('Format CubeSat : ' || v_format_cubesat);

EXCEPTION
WHEN NO_DATA_FOUND THEN
DBMS_OUTPUT.PUT_LINE(
'Aucun satellite trouvé pour l''identifiant ' || v_id_satellite
);

WHEN OTHERS THEN
DBMS_OUTPUT.PUT_LINE(
'Erreur inattendue lors de la recherche du satellite '
|| v_id_satellite || ' : ' || SQLERRM
);
END;
/

