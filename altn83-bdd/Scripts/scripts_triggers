/* T5 - TRG_HISTORIQUE_STATUT */

/* Cas valide T5 : Changement de statut d'un satellite.
Résultat attendu => update accepté et  insertion d'une ligne dans HISTORIQUE_STATUT */

SAVEPOINT sp_t5_valide;

DECLARE
    v_avant NUMBER;
    v_apres NUMBER;
BEGIN
    SELECT COUNT(*)
    INTO v_avant
    FROM HISTORIQUE_STATUT
    WHERE id_satellite = 'SAT-004';

    UPDATE SATELLITE
    SET statut = 'Défaillant'
    WHERE id_satellite = 'SAT-004';

    SELECT COUNT(*)
    INTO v_apres
    FROM HISTORIQUE_STATUT
    WHERE id_satellite = 'SAT-004';

    IF v_apres = v_avant + 1 THEN
        DBMS_OUTPUT.PUT_LINE('OK T5 valide : historique ajouté.');
    ELSE
        DBMS_OUTPUT.PUT_LINE('ECHEC T5 valide : historique non ajouté.');
    END IF;
END;
/

ROLLBACK TO sp_t5_valide;

/* Cas "non déclenchement" T5 : Mise à jour du statut avec la même valeur.
Résultat attendu => update accepté mais aucune nouvelle ligne dans HISTORIQUE_STATUT */

SAVEPOINT sp_t5_same;

DECLARE
    v_statut SATELLITE.statut%TYPE;
    v_avant NUMBER;
    v_apres NUMBER;
BEGIN
    SELECT statut INTO v_statut
    FROM SATELLITE
    WHERE id_satellite = 'SAT-001';

    SELECT COUNT(*)
    INTO v_avant
    FROM HISTORIQUE_STATUT
    WHERE id_satellite = 'SAT-001';

    UPDATE SATELLITE
    SET statut = v_statut
    WHERE id_satellite = 'SAT-001';

    SELECT COUNT(*)
    INTO v_apres
    FROM HISTORIQUE_STATUT
    WHERE id_satellite = 'SAT-001';

    IF v_apres = v_avant THEN
        DBMS_OUTPUT.PUT_LINE('OK T5 non déclenchement : aucune ligne ajoutée.');
    ELSE
        DBMS_OUTPUT.PUT_LINE('ECHEC T5 non déclenchement : une ligne a été ajoutée à tort.');
    END IF;
END;
/

ROLLBACK TO sp_t5_same;