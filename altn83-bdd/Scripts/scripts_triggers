/* 1. trg_valider_fenetre */

CREATE OR REPLACE TRIGGER trg_valider_fenetre
BEFORE INSERT ON FENETRE_COM
FOR EACH ROW
DECLARE
    v_statut_satellite  SATELLITE.statut%TYPE;
    v_statut_station    STATION_SOL.statut%TYPE;
BEGIN
    SELECT statut
    INTO v_statut_satellite
    FROM SATELLITE
    WHERE id_satellite = :NEW.id_satellite;

    IF v_statut_satellite = 'Désorbité' THEN
        RAISE_APPLICATION_ERROR(
            -20001,
            'Insertion refusée : le satellite ' || :NEW.id_satellite || ' est désorbité.'
        );
    END IF;

    SELECT statut
    INTO v_statut_station
    FROM STATION_SOL
    WHERE code_station = :NEW.code_station;

    IF v_statut_station = 'Maintenance' THEN
        RAISE_APPLICATION_ERROR(
            -20002,
            'Insertion refusée : la station ' || :NEW.code_station || ' est en maintenance.'
        );
    END IF;
END;
/
SHOW ERRORS TRIGGER trg_valider_fenetre;

/* 2. trg_no_chevauchement */

CREATE OR REPLACE TRIGGER trg_no_chevauchement
FOR INSERT OR UPDATE ON FENETRE_COM
COMPOUND TRIGGER

    TYPE t_fenetre_rec IS RECORD (
        id_fenetre      FENETRE_COM.id_fenetre%TYPE,
        id_satellite    FENETRE_COM.id_satellite%TYPE,
        code_station    FENETRE_COM.code_station%TYPE,
        date_debut      FENETRE_COM.datetime_debut%TYPE,
        duree           FENETRE_COM.duree%TYPE
    );

    TYPE t_fenetre_tab IS TABLE OF t_fenetre_rec INDEX BY PLS_INTEGER;
    g_fenetres t_fenetre_tab;
    g_idx NUMBER := 0;

    AFTER EACH ROW IS
    BEGIN
        g_idx := g_idx + 1;
        g_fenetres(g_idx).id_fenetre   := :NEW.id_fenetre;
        g_fenetres(g_idx).id_satellite := :NEW.id_satellite;
        g_fenetres(g_idx).code_station := :NEW.code_station;
        g_fenetres(g_idx).date_debut   := :NEW.datetime_debut;
        g_fenetres(g_idx).duree        := :NEW.duree;
    END AFTER EACH ROW;

    AFTER STATEMENT IS
        v_nb NUMBER;
        v_fin TIMESTAMP;
    BEGIN
        FOR i IN 1 .. g_idx LOOP
            v_fin := g_fenetres(i).date_debut
                     + NUMTODSINTERVAL(g_fenetres(i).duree, 'SECOND');

            SELECT COUNT(*)
            INTO v_nb
            FROM FENETRE_COM f
            WHERE f.id_satellite = g_fenetres(i).id_satellite
              AND f.id_fenetre <> g_fenetres(i).id_fenetre
              AND f.datetime_debut < v_fin
              AND (f.datetime_debut + NUMTODSINTERVAL(f.duree, 'SECOND')) > g_fenetres(i).date_debut;

            IF v_nb > 0 THEN
                RAISE_APPLICATION_ERROR(
                    -20003,
                    'Chevauchement refusé : le satellite ' || g_fenetres(i).id_satellite ||
                    ' a déjà une fenêtre sur cette période.'
                );
            END IF;

            SELECT COUNT(*)
            INTO v_nb
            FROM FENETRE_COM f
            WHERE f.code_station = g_fenetres(i).code_station
              AND f.id_fenetre <> g_fenetres(i).id_fenetre
              AND f.datetime_debut < v_fin
              AND (f.datetime_debut + NUMTODSINTERVAL(f.duree, 'SECOND')) > g_fenetres(i).date_debut;

            IF v_nb > 0 THEN
                RAISE_APPLICATION_ERROR(
                    -20004,
                    'Chevauchement refusé : la station ' || g_fenetres(i).code_station ||
                    ' est déjà occupée sur cette période.'
                );
            END IF;
        END LOOP;
    END AFTER STATEMENT;

END trg_no_chevauchement;
/
SHOW ERRORS TRIGGER trg_no_chevauchement;

/* 3. trg_volume_realise */

CREATE OR REPLACE TRIGGER trg_volume_realise
BEFORE INSERT OR UPDATE ON FENETRE_COM
FOR EACH ROW
BEGIN
    IF :NEW.statut <> 'Réalisée' THEN
        :NEW.volume_donnees := NULL;
    END IF;
END;
/
SHOW ERRORS TRIGGER trg_volume_realise;

/* 4. trg_mission_terminee */

CREATE OR REPLACE TRIGGER trg_mission_terminee
BEFORE INSERT ON PARTICIPATION
FOR EACH ROW
DECLARE
    v_statut_mission    MISSION.statut_mission%TYPE;
    v_statut_satellite  SATELLITE.statut%TYPE;
BEGIN
    SELECT statut_mission
    INTO v_statut_mission
    FROM MISSION
    WHERE id_mission = :NEW.id_mission;

    IF v_statut_mission = 'Terminée' THEN
        RAISE_APPLICATION_ERROR(
            -20005,
            'Insertion refusée : la mission ' || :NEW.id_mission || ' est terminée.'
        );
    END IF;

    SELECT statut
    INTO v_statut_satellite
    FROM SATELLITE
    WHERE id_satellite = :NEW.id_satellite;

    IF v_statut_satellite = 'Désorbité' THEN
        RAISE_APPLICATION_ERROR(
            -20006,
            'Insertion refusée : le satellite ' || :NEW.id_satellite || ' est désorbité.'
        );
    END IF;
END;
/
SHOW ERRORS TRIGGER trg_mission_terminee;

/* 5. trg_historique_statut */

CREATE OR REPLACE TRIGGER trg_historique_statut
AFTER UPDATE OF statut ON SATELLITE
FOR EACH ROW
BEGIN
IF NVL(:OLD.statut, '#NULL#') <> NVL(:NEW.statut, '#NULL#') THEN
INSERT INTO HISTORIQUE_STATUT (
id_satellite,
ancien_statut,
nouveau_statut,
date_changement,
motif
)
VALUES (
:NEW.id_satellite,
:OLD.statut,
:NEW.statut,
SYSTIMESTAMP,
'Changement de statut automatique tracé par trigger'
);
END IF;
END;
/
SHOW ERRORS TRIGGER trg_historique_statut;

/* TESTS TRIGGERS */

