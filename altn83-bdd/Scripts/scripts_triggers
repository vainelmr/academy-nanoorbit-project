/* T3 - TRG_VOLUME_REALISE */

/* Cas valide T3 : Fenêtre Réalisée avec volume renseigné.
Résultat attendu => insertion acceptée et volume conservé */

SAVEPOINT sp_t3_valide;

INSERT INTO FENETRE_COM (
    datetime_debut,
    duree,
    elevation_max,
    volume_donnees,
    statut,
    id_satellite,
    code_station
) VALUES (
    TO_TIMESTAMP('2024-02-13 15:00:00', 'YYYY-MM-DD HH24:MI:SS'),
    220,
    62.0,
    777,
    'Réalisée',
    'SAT-003',
    'GS-TLS-01'
);

DECLARE
    v_volume FENETRE_COM.volume_donnees%TYPE;
BEGIN
    SELECT volume_donnees
    INTO v_volume
    FROM FENETRE_COM
    WHERE datetime_debut = TO_TIMESTAMP('2024-02-13 15:00:00', 'YYYY-MM-DD HH24:MI:SS')
      AND id_satellite = 'SAT-003'
      AND code_station = 'GS-TLS-01';

    IF v_volume = 777 THEN
        DBMS_OUTPUT.PUT_LINE('OK T3 valide : volume conservé.');
    ELSE
        DBMS_OUTPUT.PUT_LINE('ECHEC T3 valide : volume non conservé.');
    END IF;
END;
/

ROLLBACK TO sp_t3_valide;

/* Cas erreur métier T3 : Fenêtre Planifiée avec volume renseigné.
Résultat attendu => insertion acceptée mais volume_donnees forcé à NULL */

SAVEPOINT sp_t3_erreur;

INSERT INTO FENETRE_COM (
    datetime_debut,
    duree,
    elevation_max,
    volume_donnees,
    statut,
    id_satellite,
    code_station
) VALUES (
    TO_TIMESTAMP('2024-02-13 14:00:00', 'YYYY-MM-DD HH24:MI:SS'),
    220,
    62.0,
    999,
    'Planifiée',
    'SAT-003',
    'GS-TLS-01'
);

DECLARE
    v_volume FENETRE_COM.volume_donnees%TYPE;
BEGIN
    SELECT volume_donnees
    INTO v_volume
    FROM FENETRE_COM
    WHERE datetime_debut = TO_TIMESTAMP('2024-02-13 14:00:00', 'YYYY-MM-DD HH24:MI:SS')
      AND id_satellite = 'SAT-003'
      AND code_station = 'GS-TLS-01';

    IF v_volume IS NULL THEN
        DBMS_OUTPUT.PUT_LINE('OK T3 contrôle : volume forcé à NULL.');
    ELSE
        DBMS_OUTPUT.PUT_LINE('ECHEC T3 contrôle : volume non null.');
    END IF;
END;
/

ROLLBACK TO sp_t3_erreur;

