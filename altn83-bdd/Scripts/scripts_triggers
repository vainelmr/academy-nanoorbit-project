/* T1 - TRG_VALIDER_FENETRE */

/* Cas valide T1 : Insertion d'une fenêtre pour un satellite opérationnelet une station active.
Résultat attendu => insertion acceptée */

SAVEPOINT sp_t1_valide;

BEGIN
    INSERT INTO FENETRE_COM (
        datetime_debut,
        duree,
        elevation_max,
        volume_donnees,
        statut,
        id_satellite,
        code_station
    ) VALUES (
        TO_TIMESTAMP('2024-02-10 12:00:00', 'YYYY-MM-DD HH24:MI:SS'),
        240,
        65.0,
        NULL,
        'Planifiée',
        'SAT-001',
        'GS-KIR-01'
    );

    DBMS_OUTPUT.PUT_LINE('OK T1 valide : insertion acceptée.');
EXCEPTION
    WHEN OTHERS THEN
        DBMS_OUTPUT.PUT_LINE('ECHEC T1 valide : ' || SQLERRM);
END;
/

ROLLBACK TO sp_t1_valide;

